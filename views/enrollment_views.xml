<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_student_enrollment_list_inherit_incentive" model="ir.ui.view">
        <field name="name">student.enrollment.list.incentive</field>
        <field name="model">student.enrollment</field>
        <field name="inherit_id" ref="student_details_19.view_student_enrollment_list"/>
        <field name="arch" type="xml">
            <field name="due_amount" position="after">
                <field name="assigned_officer_id" optional="show"/>
            </field>
        </field>
    </record>

    <record id="view_student_enrollment_form_inherit_incentive" model="ir.ui.view">
        <field name="name">student.enrollment.form.incentive</field>
        <field name="model">student.enrollment</field>
        <field name="inherit_id" ref="student_details_19.view_student_enrollment_form"/>
        <field name="arch" type="xml">
            <field name="next_due_date" position="after">
                <field name="assigned_officer_id"/>
                <field name="assigned_officer_date" readonly="1"
                       invisible="not assigned_officer_id"/>
            </field>
        </field>
    </record>

    <!-- ── Balances Needing Collection (due_amount > 0) ─────────────────── -->
    <record id="view_student_enrollment_search_incentive" model="ir.ui.view">
        <field name="name">student.enrollment.search.incentive</field>
        <field name="model">student.enrollment</field>
        <field name="arch" type="xml">
            <search>
                <field name="student_id"/>
                <field name="batch_id"/>
                <field name="assigned_officer_id"/>
                <filter name="filter_due" string="Has Balance Due" domain="[('due_amount', '&gt;', 0)]"/>
                <filter name="unassigned" string="Unassigned"
                        domain="[('assigned_officer_id', '=', False), ('due_amount', '&gt;', 0)]"/>
                <separator/>
                <filter name="group_officer" string="Admission Officer" context="{'group_by': 'assigned_officer_id'}"/>
                <filter name="group_batch" string="Batch" context="{'group_by': 'batch_id'}"/>
            </search>
        </field>
    </record>

    <record id="action_incentive_pending_balances" model="ir.actions.act_window">
        <field name="name">Balances to Collect</field>
        <field name="res_model">student.enrollment</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('due_amount', '&gt;', 0)]</field>
        <field name="search_view_id" ref="view_student_enrollment_search_incentive"/>
    </record>
</odoo>
