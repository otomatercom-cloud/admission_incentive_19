<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_incentive_bulk_assign_wizard_form" model="ir.ui.view">
        <field name="name">incentive.bulk.assign.wizard.form</field>
        <field name="model">incentive.bulk.assign.wizard</field>
        <field name="arch" type="xml">
            <form string="Bulk Assign to Admission Officer">
                <sheet>
                    <group>
                        <field name="enrollment_count" string="Selected Students"/>
                        <field name="officer_id"/>
                    </group>
                    <field name="enrollment_ids" readonly="1">
                        <list>
                            <field name="student_id"/>
                            <field name="batch_id"/>
                            <field name="due_amount"/>
                        </list>
                    </field>
                </sheet>
                <footer>
                    <button name="action_bulk_assign" type="object"
                            string="Assign" class="btn-primary"/>
                    <button string="Cancel" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_server_bulk_assign_officer" model="ir.actions.server">
        <field name="name">Assign to Admission Officer</field>
        <field name="model_id" ref="student_details_19.model_student_enrollment"/>
        <field name="binding_model_id" ref="student_details_19.model_student_enrollment"/>
        <field name="binding_view_types">list</field>
        <field name="state">code</field>
        <field name="code">action = env['incentive.bulk.assign.wizard'].with_context(active_ids=records.ids).action_open_wizard()</field>
    </record>
</odoo>
