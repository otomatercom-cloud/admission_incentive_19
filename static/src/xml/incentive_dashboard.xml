<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
<t t-name="admission_incentive_19.IncentiveDashboard">
<div class="o_incentive_dashboard">

    <!-- ── Header ─────────────────────────────────────────────────── -->
    <div class="o_id_header">
        <div>
            <div class="o_id_kicker">Admission Officers</div>
            <h1>Incentive Dashboard</h1>
            <p>Slab-based monthly balance-collection incentive — only fully
               settled admissions count, at their full value.</p>
        </div>
        <div class="o_id_header_actions">
            <button type="button" class="btn btn-light" t-on-click="loadData" t-att-disabled="state.loading">
                <i t-attf-class="fa {{ state.loading ? 'fa-spinner fa-spin' : 'fa-refresh' }} me-1"/>Refresh
            </button>
            <button type="button" class="btn btn-secondary" t-on-click="openBalances" t-if="isManager">
                <i class="fa fa-list me-1"/>Balances to Collect
            </button>
            <button type="button" class="btn btn-primary" t-on-click="generatePayouts"
                    t-if="isManager" t-att-disabled="state.generatingPayouts">
                <i t-attf-class="fa {{ state.generatingPayouts ? 'fa-spinner fa-spin' : 'fa-money' }} me-1"/>Generate Payouts
            </button>
        </div>
    </div>

    <!-- ── Month switcher ─────────────────────────────────────────── -->
    <div class="o_id_monthbar">
        <button type="button" class="btn btn-sm btn-outline-secondary" t-on-click="prevMonth">
            <i class="fa fa-chevron-left"/>
        </button>
        <div class="o_id_month_label" t-esc="monthLabel"/>
        <button type="button" class="btn btn-sm btn-outline-secondary" t-on-click="nextMonth">
            <i class="fa fa-chevron-right"/>
        </button>
        <span class="text-muted" style="font-size:12px;margin-left:12px;">
            Incentive slabs reset each calendar month.
        </span>
    </div>

    <div t-if="state.error" class="alert alert-danger mt-3" t-esc="state.error"/>

    <t t-if="state.loading">
        <div class="o_id_skeleton">
            <div class="o_id_skeleton_cards">
                <t t-foreach="[1,2,3,4]" t-as="n" t-key="n">
                    <div class="o_id_skeleton_card"/>
                </t>
            </div>
            <div class="o_id_skeleton_table"/>
        </div>
    </t>

    <t t-else="">
        <!-- ── Summary cards ──────────────────────────────────────── -->
        <div class="o_id_cards">
            <div class="o_id_card o_id_card_collected">
                <div class="o_id_card_icon"><i class="fa fa-money"/></div>
                <div class="o_id_card_value">₹ <t t-esc="fmt(summary.total_collected)"/></div>
                <div class="o_id_card_label">Collected This Month</div>
            </div>
            <div class="o_id_card o_id_card_pending"
                 t-att-style="isManager ? 'cursor:pointer;' : ''"
                 t-on-click="() => this.isManager &amp;&amp; this.openBalances()">
                <div class="o_id_card_icon"><i class="fa fa-exclamation-triangle"/></div>
                <div class="o_id_card_value">₹ <t t-esc="fmt(summary.total_balance_pending)"/></div>
                <div class="o_id_card_label">Balance Still Pending</div>
            </div>
            <div class="o_id_card o_id_card_commission">
                <div class="o_id_card_icon"><i class="fa fa-percent"/></div>
                <div class="o_id_card_value">₹ <t t-esc="fmt(summary.total_commission_earned)"/></div>
                <div class="o_id_card_label">Incentive Earned This Month</div>
            </div>
            <div class="o_id_card o_id_card_officers">
                <div class="o_id_card_icon"><i class="fa fa-users"/></div>
                <div class="o_id_card_value"><t t-esc="summary.officer_count"/></div>
                <div class="o_id_card_label">Officers With Assignments</div>
            </div>
        </div>

        <!-- ── Slab reference ──────────────────────────────────────── -->
        <div class="o_id_section">
            <h2>Incentive Slabs</h2>
            <div class="o_id_slab_row">
                <t t-foreach="slabs" t-as="s" t-key="s.id">
                    <div class="o_id_slab_chip">
                        <strong t-esc="s.name"/>:
                        ₹<t t-esc="fmt(s.from_amount)"/><t t-if="s.to_amount"> – ₹<t t-esc="fmt(s.to_amount)"/></t><t t-else=""> +</t>
                        → <span class="o_id_slab_pct"><t t-esc="s.percentage"/>%</span>
                    </div>
                </t>
                <t t-if="!slabs.length">
                    <span class="text-muted">No slabs configured yet.</span>
                </t>
            </div>
        </div>

        <!-- ── Officers table ──────────────────────────────────────── -->
        <div class="o_id_section">
            <h2>By Officer</h2>
            <table class="table table-sm o_id_officer_table">
                <thead>
                    <tr>
                        <th>Officer</th>
                        <th class="text-end">Assigned</th>
                        <th class="text-end">Collected ₹</th>
                        <th>Current Slab</th>
                        <th class="text-end">Earned ₹</th>
                        <th>Payout Status</th>
                        <th class="text-end">Balance Pending ₹</th>
                        <th>If Fully Collected</th>
                        <th class="text-end">Potential ₹</th>
                    </tr>
                </thead>
                <tbody>
                    <tr t-if="!officers.length">
                        <td colspan="9" class="text-center text-muted">No officers with assignments this month.</td>
                    </tr>
                    <t t-foreach="officers" t-as="o" t-key="o.officer_id">
                        <tr style="cursor:pointer;" t-on-click="() => this.toggleOfficer(o)">
                            <td><strong t-esc="o.officer_name"/></td>
                            <td class="text-end">
                                <t t-esc="o.assigned_count"/>
                                <span class="text-muted" style="font-size:11px;">(<t t-esc="o.cleared_count"/> cleared)</span>
                            </td>
                            <td class="text-end" t-esc="fmt(o.collected)"/>
                            <td>
                                <span t-if="o.slab_name" class="badge text-bg-success" t-esc="o.slab_name + ' (' + o.slab_percentage + '%)'"/>
                                <span t-else="" class="text-muted">—</span>
                            </td>
                            <td class="text-end"><strong t-esc="fmt(o.commission_earned)"/></td>
                            <td>
                                <span t-if="!o.payout_id" class="text-muted">Not generated</span>
                                <span t-elif="o.payout_state == 'paid'"
                                      t-attf-class="badge text-bg-success {{ isManager ? 'o_id_payout_link' : '' }}"
                                      t-on-click="(ev) => this.isManager &amp;&amp; this.openPayout(o, ev)">Paid in full</span>
                                <span t-elif="o.payout_state == 'partially_paid'"
                                      t-attf-class="badge text-bg-warning {{ isManager ? 'o_id_payout_link' : '' }}"
                                      t-on-click="(ev) => this.isManager &amp;&amp; this.openPayout(o, ev)">
                                    Paid ₹<t t-esc="fmt(o.payout_paid)"/> · Bal ₹<t t-esc="fmt(o.payout_balance)"/>
                                </span>
                                <span t-else=""
                                      t-attf-class="badge text-bg-info {{ isManager ? 'o_id_payout_link' : '' }}"
                                      t-on-click="(ev) => this.isManager &amp;&amp; this.openPayout(o, ev)">
                                    <t t-esc="o.payout_state"/>
                                </span>
                            </td>
                            <td class="text-end" t-esc="fmt(o.balance_pending)"/>
                            <td>
                                <span t-if="o.potential_slab_name" class="badge text-bg-info" t-esc="o.potential_slab_name + ' (' + o.potential_slab_percentage + '%)'"/>
                                <span t-else="" class="text-muted">—</span>
                            </td>
                            <td class="text-end"><strong t-esc="fmt(o.potential_commission)"/></td>
                        </tr>
                        <tr t-if="state.expandedOfficerId === o.officer_id">
                            <td colspan="9" class="o_id_drilldown">
                                <div t-if="state.officerStudentsLoading" class="text-muted">Loading…</div>
                                <table t-else="" class="table table-sm mb-0">
                                    <thead>
                                        <tr>
                                            <th>Student</th>
                                            <th>Batch</th>
                                            <th class="text-end">Total Fee ₹</th>
                                            <th class="text-end">Paid ₹</th>
                                            <th class="text-end">Due ₹</th>
                                            <th>Counted for Incentive?</th>
                                            <th>Last Payment</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <tr t-if="!state.officerStudents.length">
                                            <td colspan="7" class="text-center text-muted">No assigned students.</td>
                                        </tr>
                                        <tr t-foreach="state.officerStudents" t-as="st" t-key="st.enrollment_id">
                                            <td t-esc="st.student_name"/>
                                            <td t-esc="st.batch_name"/>
                                            <td class="text-end" t-esc="fmt(st.total_fee)"/>
                                            <td class="text-end" t-esc="fmt(st.paid_amount)"/>
                                            <td class="text-end"><strong t-esc="fmt(st.due_amount)"/></td>
                                            <td>
                                                <span t-if="st.counted_for_incentive" class="badge text-bg-success">✓ Yes — ₹<t t-esc="fmt(st.total_fee)"/></span>
                                                <span t-elif="st.due_amount &gt; 0" class="badge text-bg-secondary">Not fully paid yet</span>
                                                <span t-else="" class="badge text-bg-light text-muted">Paid in a different month</span>
                                            </td>
                                            <td t-esc="st.last_payment_date or '—'"/>
                                        </tr>
                                    </tbody>
                                </table>
                            </td>
                        </tr>
                    </t>
                </tbody>
            </table>
        </div>
    </t>
</div>
</t>
</templates>
